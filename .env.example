# ===========================
# Frontend (Vite) — variáveis expostas ao navegador
# Obs.: Nomes com VITE_ são incorporadas no bundle e vão para o navegador.
# ===========================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E-mail usado pelo frontend (telas de envio direto quando não usa backend SMTP)
VITE_SMTP_HOST=
VITE_SMTP_PORT=587
VITE_SMTP_SECURE=false
VITE_SMTP_USER=
VITE_SMTP_PASS=
VITE_EMAIL_FROM=

# ===========================
# Backend (Node/Express) — NÃO começam com VITE_ e NÃO vão para o navegador
# ===========================

# Obrigatório: usado para bypassar RLS e executar ações sensíveis (vincular, devolver, importar)
SUPABASE_SERVICE_ROLE=

# Servidor HTTP (bind + porta)
HOST=0.0.0.0
PORT=8089
